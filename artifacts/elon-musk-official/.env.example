# Environment Variables for Elon Musk Office
# Copy this file to .env.local and fill in your values
# These are used for Cloudflare Pages Functions

# ===========================================
# REQUIRED - Email Automation (Resend)
# ===========================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email address that sends emails
FROM_EMAIL=Independent <newsletter@yourdomain.com>

# Admin email to receive contact form submissions
ADMIN_EMAIL=admin@yourdomain.com

# ===========================================
# OPTIONAL - Google Maps API
# ===========================================
# Already configured: AIzaSyCO0kKndUNlmQi3B5mxy4dblg_8WYcuKuk

# ===========================================
# Cloudflare Pages Environment Variables
# ===========================================
# Set these in Cloudflare Dashboard:
# Pages > Your Project > Settings > Environment Variables

# For Production:
# RESEND_API_KEY = re_xxxxxxxxxxxxx
# FROM_EMAIL = Independent <newsletter@yourdomain.com>
# ADMIN_EMAIL = admin@yourdomain.com

# For Preview/Development:
# Same as production or use test values

# ===========================================
# API ENDPOINTS
# ===========================================
# POST /api/subscribe - Newsletter subscription
# POST /api/contact - Contact form
# GET  /api/unsubscribe?email=xxx - Unsubscribe
# GET  /api/health - Health check
